{% props breadcrumbs = [] %}

<nav {{ attrs({class: 'sy sy-breadcrumbs', 'aria-label': 'Breadcrumbs'}, attributes.all) }}>
    <ol class="sy-breadcrumbs-list">
        {% for url, label in breadcrumbs %}
            <li class="sy-breadcrumbs-item">
                {% if not loop.first %}
                    <twig:SylamentSupport:Icon icon="heroicons:chevron-right" :alias="constant('Sylament\\Support\\Twig\\SupportIconAlias::BREADCRUMBS_SEPARATOR')" class="sy-breadcrumbs-item-separator sy-ltr" aria-hidden="true" />
                    <twig:SylamentSupport:Icon icon="heroicons:chevron-left" :alias="constant('Sylament\\Support\\Twig\\SupportIconAlias::BREADCRUMBS_SEPARATOR_RTL')" class="sy-breadcrumbs-item-separator sy-rtl" aria-hidden="true" />
                {% endif %}

                {% if url matches '/^\\d+$/' %}
                    <span {{ attrs({class: 'sy-breadcrumbs-item-label', 'aria-current': loop.last ? 'page' : null}) }}>{{ label }}</span>
                {% else %}
                    <a {{ attrs({class: 'sy-breadcrumbs-item-label', href: url, 'aria-current': loop.last ? 'page' : null}) }}>{{ label }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</nav>

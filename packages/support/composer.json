{
    "name": "sylament/support",
    "description": "Sylament support — shared foundations for the Sylament UI bundles: closure evaluation, the component base, icons, and the styling runtime",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Martin Petricko",
            "email": "matopetricko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "symfony/stimulus-bundle": "^3.1",
        "symfony/ux-icons": "^3.3",
        "twig/twig": "^3.27"
    },
    "suggest": {
        "symfony/ux-twig-component": "To render the shipped Twig components (Icon, IconButton, Section)"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Sylament\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sylament\\Support\\Tests\\": "tests/"
        }
    }
}

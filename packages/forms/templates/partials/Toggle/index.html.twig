{% set controlTag = component.isInline ? 'span' : 'label' %}
{% set offColorAttrs = colorAttributes('Sylament\\Support\\Colors\\Components\\ToggleComponent', component.getOffColor ?? 'gray') %}
{% set onColorAttrs = colorAttributes('Sylament\\Support\\Colors\\Components\\ToggleComponent', component.getOnColor ?? 'primary') %}

{% set control %}
    <{{ controlTag }} {{ attrs({
        class: ['sy-fo-toggle', offColorAttrs.class],
        style: offColorAttrs.style,
        for: component.isInline ? false : component.getId,
    }) }}>
        <input {{ attrs({
            type: 'checkbox',
            role: 'switch',
            class: 'sy-fo-toggle-input',
            id: component.getId,
            name: component.getName,
            'data-model': component.getDataModel,
            checked: component.getState,
            'aria-invalid': component.getErrorMessages is not empty,
            disabled: component.isDisabled,
            autofocus: component.isAutofocused,
        }) }}>

        <span {{ attrs({
            class: ['sy-fo-toggle-track', onColorAttrs.class],
            style: onColorAttrs.style,
        }) }}>
            <span class="sy-fo-toggle-thumb">
                {% if component.hasOffIcon %}
                    <span class="sy-fo-toggle-icon-off"><twig:SylamentSupport:Icon :icon="component.getOffIcon" size="xs" /></span>
                {% endif %}

                {% if component.hasOnIcon %}
                    <span class="sy-fo-toggle-icon-on"><twig:SylamentSupport:Icon :icon="component.getOnIcon" size="xs" /></span>
                {% endif %}
            </span>
        </span>
    </{{ controlTag }}>
{% endset %}

<twig:SylamentForms:FieldWrapper :field="component">
    <twig:block name="labelPrefix">{% if component.isInline %}{{ control }}{% endif %}</twig:block>
    <twig:block name="content">{% if not component.isInline %}{{ control }}{% endif %}</twig:block>
</twig:SylamentForms:FieldWrapper>

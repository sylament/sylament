{% props
    navigation = [],
    brandName = null
%}

{% set sidebarController = 'sylament--panels--sidebar' %}

<aside
    {{ attrs({
        id: 'sy-pa-sidebar',
        class: 'sy sy-pa-sidebar',
    }, stimulus_target(sidebarController, 'sidebar'), attributes.all) }}
>
    <div class="sy-pa-sidebar-header-ctn">
        <header class="sy-pa-sidebar-header">
            <div class="sy-pa-sidebar-header-logo-ctn">
                <twig:SylamentPanels:Logo :brandName="brandName" />
            </div>
        </header>
    </div>

    <nav class="sy-pa-sidebar-nav" aria-label="Navigation">
        <ul class="sy-pa-sidebar-nav-groups">
            {% for group in navigation %}
                <twig:SylamentPanels:SidebarGroup :group="group" :groupIndex="loop.index0" />
            {% endfor %}
        </ul>
    </nav>
</aside>

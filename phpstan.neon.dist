parameters:
    level: max

    reportUnmatchedIgnoredErrors: true

    paths:
        - packages/actions/src
        - packages/forms/src
        - packages/infolists/src
        - packages/notifications/src
        - packages/panels/src
        - packages/schemas/src
        - packages/support/src
        - packages/tables/src
        - packages/testing/src
        - packages/widgets/src

    ignoreErrors:
        -
            identifiers:
                - trait.unused

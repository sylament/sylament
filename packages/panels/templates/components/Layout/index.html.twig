{% props
    navigation = [],
    brandName = null,

    content = markup(block('content') ?? null)
%}

{% set sidebarController = 'sylament--panels--sidebar' %}
{% set sidebarStimulus = stimulus_controller(sidebarController)
    |stimulus_action(sidebarController, 'closeOnEscape', 'keydown@window') %}

<div {{ attrs({class: 'sy sy-pa-layout'}, sidebarStimulus, attributes.all) }}>
    <a href="#sy-pa-main" class="sy-pa-skip-link">Skip to content</a>

    <twig:SylamentPanels:Topbar :brandName="brandName" />

    <div {{ attrs({class: 'sy-pa-sidebar-overlay'}, stimulus_action(sidebarController, 'close', 'click')) }}></div>

    <twig:SylamentPanels:Sidebar :navigation="navigation" />

    <main id="sy-pa-main" class="sy-pa-main">
        {{ content }}
    </main>
</div>

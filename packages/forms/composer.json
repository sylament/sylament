{
    "name": "sylament/forms",
    "description": "Sylament forms — form builder for the Sylament UI toolkit",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Martin Petricko",
            "email": "matopetricko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "doctrine/orm": "^3.6",
        "league/flysystem": "^3",
        "sylament/actions": "self.version",
        "sylament/schemas": "self.version",
        "sylament/support": "self.version",
        "symfony/http-foundation": "^8.1",
        "symfony/service-contracts": "^3.6",
        "symfony/stimulus-bundle": "^3.1",
        "symfony/string": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/ux-twig-component": "^3.1",
        "symfony/validator": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Sylament\\Forms\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sylament\\Forms\\Tests\\": "tests/"
        }
    }
}

parameters:
    level: max

    reportUnmatchedIgnoredErrors: true

    paths:
        - packages/actions/src
        - packages/forms/src
        - packages/infolists/src
        - packages/notifications/src
        - packages/panels/src
        - packages/schemas/src
        - packages/support/src
        - packages/tables/src
        - packages/widgets/src
        - tests

    excludePaths:
        - tests/*Test.php
        - tests/**/*Test.php
        - tests/Pest.php
        - tests/Expectations (?)

    ignoreErrors:
        -
            identifiers:
                - trait.unused

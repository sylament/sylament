{% set extraAttributes = group.getExtraAttributeBag.toScalarAttributes %}

<twig:SylamentSupport:Button
    :icon="group.getIcon"
    :color="group.getColor ?? 'gray'"
    :outlined="group.isOutlined"
    :size="group.getSize ?? 'md'"
    {{ ...extraAttributes }}
>
    {{- group.getLabel -}}
</twig:SylamentSupport:Button>

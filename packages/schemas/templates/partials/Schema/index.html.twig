{% set isInline = component.isInline %}
{% set alignmentClass = component.getAlignmentClass %}

{% set rootController = 'sylament--schemas--schema' %}
{% set rootStimulus = component.isRoot and component.getLiveComponentOrNull ? stimulus_controller(rootController, {schemaKey: component.getKey})
    |stimulus_action(rootController, 'onValidationError', 'form-validation-error@window')
    |stimulus_action(rootController, 'onStateReset', 'reset-schema-component-state@window') : null %}

<div
        {{ attrs({
            class: [
                'sy sy-sc',
                isInline ? 'sy-inline' : null,
                alignmentClass,
                {
                    'sy-sc-has-gap': component.hasGap,
                    'sy-sc-dense': component.isDense,
                },
            ],
        }, isInline ? null : grid(component.getColumns), component.getExtraAttributes, rootStimulus) }}
>
    {% for childComponent in visibleChildren %}
        {% if childComponent.isAction %}
            <div class="sy-sc-action">{{ renderComponent(childComponent.component) }}</div>
        {% else %}
            <div {{ attrs(
                isInline ? null : gridColumn(childComponent.component.getColumnSpan, childComponent.component.getColumnStart, childComponent.component.getColumnOrder),
                isInline and childComponent.component.canGrow(false) ? {class: ['sy-growable']} : null,
            ) }}>
                <div class="sy-sc-component">
                    {{ renderComponent(childComponent.component) }}
                </div>
            </div>
        {% endif %}
    {% endfor %}
</div>

{
  "name": "@sylament/forms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm test:types && pnpm build:js",
    "build:js": "node scripts/build-js.mjs",
    "watch": "node scripts/build-js.mjs --watch",
    "test:types": "tsc --noEmit"
  },
  "symfony": {
    "controllers": {
      "checkbox-list": {
        "main": "dist/controllers/checkbox_list_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "file-upload": {
        "main": "dist/controllers/file_upload_controller.js",
        "fetch": "lazy",
        "enabled": true
      },
      "repeater": {
        "main": "dist/controllers/repeater_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "select": {
        "main": "dist/controllers/select_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "tags-input": {
        "main": "dist/controllers/tags_input_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "text-input": {
        "main": "dist/controllers/text_input_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "textarea": {
        "main": "dist/controllers/textarea_controller.js",
        "fetch": "eager",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "cropperjs": "^1.5.13",
    "filepond": "^4.32.12",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-crop": "^2.0.6",
    "filepond-plugin-image-edit": "^1.6.3",
    "filepond-plugin-image-exif-orientation": "^1.0.11",
    "filepond-plugin-image-preview": "^4.6.12",
    "filepond-plugin-image-resize": "^2.0.10",
    "filepond-plugin-image-transform": "^3.8.7",
    "sortablejs": "^1.15.7"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@symfony/ux-live-component": "^3.2.0"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@sylament/schemas": "workspace:*",
    "@symfony/ux-live-component": "^3.2.0",
    "@types/sortablejs": "^1.15.9",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}

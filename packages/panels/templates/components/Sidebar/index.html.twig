{% props
    navigation = [],
    brandName = null
%}

{% set sidebarController = 'sylament--panels--sidebar' %}

<aside
    {{ attrs({
        id: 'sy-pa-sidebar',
        class: 'sy sy-pa-sidebar',
    }, stimulus_target(sidebarController, 'sidebar'), attributes.all) }}
>
    <nav class="sy-pa-sidebar-nav">
        <ul class="sy-pa-sidebar-groups">
            {% for group in navigation %}
                <twig:SylamentPanels:SidebarGroup :group="group" :groupIndex="loop.index0" />
            {% endfor %}
        </ul>
    </nav>
</aside>

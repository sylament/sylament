{# A URL navigates and a disabled control cannot be clicked, so neither carries click
   wiring. The URL half matches the other four trigger templates, which wrap their whole
   click branch in `{% if not component.getUrl %}`; the disabled half is this template's
   own long-standing extra (the others emit the binding and lean on the `disabled`
   attribute). Hoisted so the close and mount attributes cannot drift apart again. #}
{% set clickWiringSuppressed = component.getUrl or component.isDisabled %}
{% set closeAttributes = component.shouldClose
    and not component.getClientClickHandler
    and not component.getParentActionCallLiveComponentClickHandler
    and not clickWiringSuppressed
    ? { 'data-action': 'sylament--support--modal#dismiss' }
    : {} %}
{% set clickParameters = component.getClientClickHandler
    ? { action: component.getClientClickHandler }
    : (component.getParentActionCallLiveComponentClickHandler
        ? {
            action: component.getParentActionCallLiveComponentClickHandler,
            ...(component.getArguments ? { arguments: component.getArguments } : {}),
        }
        : (component.shouldClose
            ? null
            : {
                action: 'mountAction',
                name: component.getName,
                ...(component.getInvokedArguments ? { arguments: component.getInvokedArguments } : {}),
                ...(component.getContext ? { context: component.getContext } : {}),
            })) %}
{% set mountAttributes = clickWiringSuppressed or clickParameters is null
    ? {}
    : stimulus_action('live', 'action', null, clickParameters).toArray() %}

{% set extraAttributes = component.getExtraAttributeBag.toScalarAttributes %}
{% set rootClasses = classes('sy-ac', extraAttributes.class ?? null) %}
{% component 'SylamentSupport:IconButton' with {
    icon: component.getIcon,
    label: component.getLabel ?? component.getName,
    color: component.getColor,
    size: component.getSize ?? 'md',
    iconSize: component.getIconSize,
    disabled: component.isDisabled,
    tag: component.getUrl ? 'a' : 'button',
    href: component.getUrl,
    target: component.shouldOpenUrlInNewTab ? '_blank' : null,
    ...(component.getTooltip ? { title: component.getTooltip } : {}),
}|merge(extraAttributes)|merge({ class: rootClasses })|merge(mountAttributes)|merge(closeAttributes) %}{% endcomponent %}

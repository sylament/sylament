{% set repeaterController = 'sylament--forms--repeater' %}
{% set sortableController = 'sylament--support--sortable' %}
{% set repeaterStimulus = hasController ? stimulus_controller(repeaterController, {key: component.getKey}) : null %}
{% set sortableStimulus = isDragReorderable ? stimulus_controller(sortableController, {
    animationDuration: animationDuration,
})|stimulus_action(repeaterController, 'reorder', sortableController ~ ':end') : null %}

<twig:SylamentForms:FieldWrapper :field="component" :labelAsHeading="true">
    <div
            {{ attrs({
                class: ['sy', 'sy-fo-simple-repeater'],
                id: component.getId,
                role: 'group',
                'aria-labelledby': component.getId ~ '-label',
            }, repeaterStimulus) }}
    >
        {% if itemRows is not empty %}
            <ul {{ attrs({class: 'sy-fo-simple-repeater-items'}, grid(gridColumns), sortableStimulus) }}>
                {% for row in itemRows %}
                    <li
                            {{ attrs({
                                class: 'sy-fo-simple-repeater-item',
                                id: component.getKey ~ '.' ~ row.key,
                                'data-item-key': row.key,
                                'data-sortable-item': isDragReorderable ? row.key : null,
                            }) }}
                    >
                        <div class="sy-fo-simple-repeater-item-content">
                            {{ renderComponent(row.schema) }}
                        </div>

                        {% if row.reorderAction or row.moveUpAction or row.moveDownAction or row.extraItemActions is not empty or row.cloneAction or row.deleteAction %}
                            <ul class="sy-fo-simple-repeater-item-actions">
                                {% if row.reorderAction %}
                                    <li>{{ renderComponent(row.reorderAction) }}</li>
                                {% endif %}

                                {% if row.moveUpAction %}
                                    <li>{{ renderComponent(row.moveUpAction) }}</li>
                                {% endif %}

                                {% if row.moveDownAction %}
                                    <li>{{ renderComponent(row.moveDownAction) }}</li>
                                {% endif %}

                                {% for extraItemAction in row.extraItemActions %}
                                    <li>{{ renderComponent(extraItemAction) }}</li>
                                {% endfor %}

                                {% if row.cloneAction %}
                                    <li>{{ renderComponent(row.cloneAction) }}</li>
                                {% endif %}

                                {% if row.deleteAction %}
                                    <li>{{ renderComponent(row.deleteAction) }}</li>
                                {% endif %}
                            </ul>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if addAction %}
            <div {{ attrs({class: ['sy-fo-simple-repeater-add', component.getAddActionAlignmentClass]}) }}>
                {{ renderComponent(addAction) }}
            </div>
        {% endif %}
    </div>
</twig:SylamentForms:FieldWrapper>

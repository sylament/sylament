{% props
    tag = 'button',
    type = 'button',
    href = null,
    target = null,
    formId = null,
    disabled = false,

    size = 'md',
    color = 'primary',

    icon = null,
    iconAlias = null,
    iconSize = null,

    label = null
%}

{% set knownSizes = ['xs', 'sm', 'md', 'lg', 'xl'] %}
{% set sizeValue = size.value ?? size %}
{% set iconSize = iconSize ?? (sizeValue == 'xs' ? 'sm' : (sizeValue in ['lg', 'xl'] ? 'lg' : null)) %}
{% set colorAttrs = colorAttributes('Sylament\\Support\\Colors\\Components\\IconButtonComponent', color) %}
{% set ariaLabel = (label ?? '')|striptags|trim %}

<{{ tag }}
    {{ attributes.without('style').defaults({
        class: classes('sy sy-icon-btn', {
            'sy-disabled': disabled,
            ('sy-size-' ~ sizeValue): sizeValue in knownSizes,
            (sizeValue ?? ''): sizeValue is not empty and sizeValue not in knownSizes,
        }, colorAttrs.class),
        style: styles(colorAttrs.style, attributes.all.style ?? null) ?: false,
        'aria-disabled': disabled ? 'true' : null,
        'aria-label': ariaLabel != '' ? ariaLabel : null,
        disabled: disabled and tag == 'button',
        form: formId ?: false,
        href: tag == 'a' and href ? href : false,
        target: tag == 'a' and target == '_blank' ? '_blank' : false,
        title: label ?: false,
        type: tag == 'button' ? type : false,
    }) }}
>
    {{ generateIconHtml(icon, iconAlias, size: iconSize) }}
</{{ tag }}>

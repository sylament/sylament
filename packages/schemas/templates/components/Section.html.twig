{% set label = component.getLabel %}

{% set hasLabel = (label ?? '')|trim is not empty %}

<div
        {{ html_attr({
            class: ['sy', 'sy-sc-section'],
        }, component.getExtraAttributes, id ? { id: id } : null) }}
>
    {% if hasLabel %}
        <div class="sy-sc-section-label-ctn">
            <div
                    {{ html_attr({
                        id: labelId,
                        class: html_classes('sy-sc-section-label', {
                            'sy-sc-section-label-hidden': component.isLabelHidden,
                        })|split(' '),
                    }) }}
            >
                {{ label }}
            </div>
        </div>
    {% endif %}

    <twig:SylamentSupport:Section
            :heading="component.getHeading"
            :description="component.getDescription"
            :compact="component.isCompact"
            :contained="component.isContained"
            :contentBefore="component.hasContentBefore"
            :contentId="contentId"
            :descriptionId="descriptionId"
            :divided="component.isDivided"
            :hasContentEl="false"
            :headingId="headingId"
            :labelledById="labelledById"
            :secondary="component.isSecondary"
            :aside="component.isAside"
    >
        {{ renderComponent(childSchema) }}
    </twig:SylamentSupport:Section>
</div>

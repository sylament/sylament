{% set keyValueController = 'sylament--forms--key-value' %}
{% set sortableController = 'sylament--support--sortable' %}

{% set isDisabled = component.isDisabled %}
{% set canEditKeys = component.canEditKeys %}
{% set canEditValues = component.canEditValues %}

{% set hasReorderColumn = isReorderable %}
{% set hasActionsColumn = component.isDeletable %}
{% set hasAddAction = component.isAddable %}

{% set keyLabel = component.getKeyLabel %}
{% set valueLabel = component.getValueLabel %}
{% set keyPlaceholder = component.getKeyPlaceholder %}
{% set valuePlaceholder = component.getValuePlaceholder %}
{% set statePath = component.getStatePath %}

{% set keyValueStimulus = stimulus_controller(keyValueController, {
    key: component.getKey,
    movedMessage: announcesReordering ? 'components.key_value.reordering.moved'|trans({label: '__LABEL__', position: '__POSITION__', count: '__COUNT__'}, domain: 'sylament-forms') : null,
}) %}
{% set sortableStimulus = hasReorderColumn ? stimulus_controller(sortableController, {
    animationDuration: animationDuration,
})|stimulus_action(keyValueController, 'reorder', sortableController ~ ':end') : null %}
{% set moveStimulus = hasReorderColumn ? stimulus_action(keyValueController, 'move', 'click') : null %}

<twig:SylamentForms:FieldWrapper :field="component" :labelAsHeading="true">
    <twig:SylamentSupport:InputWrapper
        class="sy-fo-key-value"
        role="group"
        :aria-labelledby="component.getLabel is not null ? component.getId ~ '-label' : null"
        :aria-describedby="component.getAccessibilityAttributes['aria-describedby']"
        :disabled="isDisabled"
        :valid="component.getErrorMessages is empty"
    >
        <div {{ attrs({class: 'sy-fo-key-value-table-ctn'}, keyValueStimulus) }}>
            <table
                    {{ attrs({
                        class: 'sy-fo-key-value-table',
                        id: component.getId,
                        'aria-labelledby': component.getLabel is not null ? component.getId ~ '-label' : null,
                    }) }}
            >
                <thead>
                    <tr>
                        {% if hasReorderColumn %}
                            <th scope="col" class="sy-fo-key-value-action-col"><span class="sy-sr-only">{{ 'components.key_value.columns.reorder.label'|trans(domain: 'sylament-forms') }}</span></th>
                        {% endif %}

                        <th scope="col">{{ keyLabel }}</th>
                        <th scope="col">{{ valueLabel }}</th>

                        {% if hasActionsColumn %}
                            <th scope="col" class="sy-fo-key-value-action-col"><span class="sy-sr-only">{{ 'components.key_value.columns.actions.label'|trans(domain: 'sylament-forms') }}</span></th>
                        {% endif %}
                    </tr>
                </thead>

                <tbody {{ attrs(sortableStimulus) }}>
                    {% for row in rows %}
                        <tr {{ attrs({'data-sortable-item': hasReorderColumn ? row.index : null}) }}>
                            {% if hasReorderColumn %}
                                <td class="sy-fo-key-value-action-col">
                                    <div class="sy-fo-key-value-table-row-sortable-handle">{{ renderComponent(reorderAction) }}</div>
                                    <div class="sy-sr-only">
                                        <button {{ attrs({
                                            type: 'button',
                                            tabindex: '-1',
                                            'data-reorder-hidden': true,
                                            'data-reorder-direction': 'up',
                                            'aria-describedby': row.reorderingDescriptionId,
                                            disabled: loop.first,
                                        }, moveStimulus) }}>{{ 'components.key_value.actions.move_up.label'|trans(domain: 'sylament-forms') }}</button>
                                        <button {{ attrs({
                                            type: 'button',
                                            tabindex: '-1',
                                            'data-reorder-hidden': true,
                                            'data-reorder-direction': 'down',
                                            'aria-describedby': row.reorderingDescriptionId,
                                            disabled: loop.last,
                                        }, moveStimulus) }}>{{ 'components.key_value.actions.move_down.label'|trans(domain: 'sylament-forms') }}</button>
                                    </div>
                                </td>
                            {% endif %}

                            <td>
                                <input {{ attrs({
                                    class: 'sy-fo-input',
                                    type: 'text',
                                    'aria-label': keyLabel,
                                    'data-model': component.getDataModel(statePath ~ '.' ~ row.index ~ '.key'),
                                    value: row.key ?? '',
                                    placeholder: keyPlaceholder ?: false,
                                    disabled: not canEditKeys or isDisabled,
                                }) }}>
                            </td>

                            <td>
                                <input {{ attrs({
                                    class: 'sy-fo-input',
                                    type: 'text',
                                    'aria-label': valueLabel,
                                    'data-model': component.getDataModel(statePath ~ '.' ~ row.index ~ '.value'),
                                    value: row.value ?? '',
                                    placeholder: valuePlaceholder ?: false,
                                    disabled: not canEditValues or isDisabled,
                                }) }}>
                            </td>

                            {% if hasActionsColumn %}
                                <td class="sy-fo-key-value-action-col">
                                    {% if row.deleteAction %}{{ renderComponent(row.deleteAction) }}{% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if hasReorderColumn %}
                {% for row in rows %}
                    <span {{ attrs({
                        id: row.reorderingDescriptionId,
                        class: 'sy-sr-only',
                        'data-reorder-description': row.index,
                        'data-reorder-label': row.reorderingLabel,
                    }, stimulus_target(keyValueController, 'reorderDescription')) }}>{{ 'components.key_value.reordering.position'|trans({label: row.reorderingLabel, position: loop.index, count: loop.length}, domain: 'sylament-forms') }}</span>
                {% endfor %}

                <span {{ attrs({
                    id: component.getId ~ '-reorder-status',
                    class: 'sy-sr-only',
                    role: 'status',
                    'aria-live': 'polite',
                    'aria-atomic': 'true',
                    'data-live-ignore': true,
                }, stimulus_target(keyValueController, 'reorderStatus')) }}></span>
            {% endif %}

            {% if hasAddAction %}
                <div class="sy-fo-key-value-add-action-ctn">{{ renderComponent(addAction) }}</div>
            {% endif %}
        </div>
    </twig:SylamentSupport:InputWrapper>
</twig:SylamentForms:FieldWrapper>

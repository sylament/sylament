{% set searchController = 'sylament--panels--global-search' %}
{% set instructionsId = 'sy-pa-global-search-instructions' %}
{% set resultsId = 'sy-pa-global-search-results' %}

{% set panel = this.getPanel %}
{% set results = this.getResults %}
{% set resultsCount = results is null ? 0 : results.getCategories|reduce((count, groupResults) => count + groupResults|length, 0) %}
{% set resultsMessage = resultsCount > 0
    ? 'global-search.results_count'|trans({count: resultsCount}, domain: 'sylament-panels')
    : 'global-search.no_results_message'|trans(domain: 'sylament-panels') %}

<div {{ attrs({class: 'sy sy-pa-global-search-ctn'}, attributes.all) }}>
    {# The search controller must never merge into the live root's bag above: that
       bag carries `data-controller="live"`, and `attrs()` replaces a repeated
       attribute rather than appending to it. #}
    <div {{ attrs(
        {class: 'sy-pa-global-search'},
        stimulus_controller(searchController, {
            keyBindings: panel.getGlobalSearchKeyBindings,
            loadingMessage: 'global-search.loading_message'|trans(domain: 'sylament-panels'),
            failureMessage: 'global-search.failure_message'|trans(domain: 'sylament-panels'),
        }),
    ) }}>
        <div class="sy-pa-global-search-field">
            <label for="sy-pa-global-search-input" class="sy-pa-global-search-label">{{ 'global-search.field.label'|trans(domain: 'sylament-panels') }}</label>

            <twig:SylamentSupport:InputWrapper
                prefixIcon="heroicons:magnifying-glass-20-solid"
                :prefixIconAlias="constant('Sylament\\Panels\\Twig\\PanelsIconAlias::GLOBAL_SEARCH_FIELD')"
                :inlinePrefix="true"
                :suffix="panel.getGlobalSearchFieldSuffix"
                :inlineSuffix="true"
            >
                <input {{ attrs({
                    class: 'sy-pa-global-search-input',
                    type: 'search',
                    id: 'sy-pa-global-search-input',
                    'data-model': 'debounce(' ~ panel.getGlobalSearchDebounceMilliseconds ~ ')|search',
                    placeholder: 'global-search.field.placeholder'|trans(domain: 'sylament-panels'),
                    autocomplete: 'off',
                    maxlength: 1000,
                    'aria-describedby': instructionsId,
                    'aria-controls': results is null ? null : resultsId,
                }, stimulus_target(searchController, 'input')|stimulus_action(searchController, 'focusFirstResult', 'keydown.down')|stimulus_action(searchController, 'inputChanged', 'input')) }}>
            </twig:SylamentSupport:InputWrapper>
        </div>

        <p id="{{ instructionsId }}" class="sy-sr-only">{{ 'global-search.field.instructions'|trans(domain: 'sylament-panels') }}</p>

        <p {{ attrs({
            id: 'sy-pa-global-search-status',
            class: 'sy-sr-only',
            role: 'status',
            'aria-atomic': 'true',
            'data-live-ignore': true,
        }, stimulus_target(searchController, 'status')) }}></p>

        {% if results is not null %}
            <div {{ attrs(
                {
                    id: resultsId,
                    class: 'sy-pa-global-search-results-ctn',
                    role: 'region',
                    'aria-label': 'global-search.results_label'|trans(domain: 'sylament-panels'),
                    'data-message': resultsMessage,
                },
                stimulus_target(searchController, 'resultsPanel')|stimulus_action(searchController, 'navigate', 'keydown'),
            ) }}>
                {% if results.getCategories is empty %}
                    <p class="sy-pa-global-search-no-results-message">{{ 'global-search.no_results_message'|trans(domain: 'sylament-panels') }}</p>
                {% else %}
                    <ul class="sy-pa-global-search-results">
                        {% for group, groupResults in results.getCategories %}
                            <li class="sy-pa-global-search-result-group">
                                <h3 class="sy-pa-global-search-result-group-header">{{ group }}</h3>

                                <ul class="sy-pa-global-search-result-group-results">
                                    {% for result in groupResults %}
                                        {% set visibleActions = result.getVisibleActions %}

                                        <li {{ attrs({
                                            class: ['sy-pa-global-search-result', {
                                                'sy-pa-global-search-result-has-actions': visibleActions is not empty,
                                            }],
                                        }) }}>
                                            <a {{ attrs({
                                                class: 'sy-pa-global-search-result-link',
                                                href: result.url,
                                            }, stimulus_action(searchController, 'close')) }}>
                                                <h4 class="sy-pa-global-search-result-heading">{{ result.title }}</h4>

                                                {% if result.details is not empty %}
                                                    <dl class="sy-pa-global-search-result-details">
                                                        {% for label, value in result.details %}
                                                            <div class="sy-pa-global-search-result-detail">
                                                                {% if result.hasDetailLabels %}
                                                                    <dt class="sy-pa-global-search-result-detail-label">{{ 'global-search.result.detail_label'|trans({label: '' ~ label}, domain: 'sylament-panels') }}</dt>
                                                                {% endif %}

                                                                <dd class="sy-pa-global-search-result-detail-value">{{ value }}</dd>
                                                            </div>
                                                        {% endfor %}
                                                    </dl>
                                                {% endif %}
                                            </a>

                                            {% if visibleActions is not empty %}
                                                <div class="sy-pa-global-search-result-actions">
                                                    {% for action in visibleActions %}
                                                        {{ renderComponent(action) }}
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>

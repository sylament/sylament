{% props
    brandName = null,

    end = markup(block('end') ?? null)
%}

<header
    {{ attrs({
        id: 'sy-pa-topbar',
        class: 'sy sy-pa-topbar',
    }, attributes.all) }}
>
    <button
        type="button"
        class="sy-pa-topbar-open-sidebar-btn"
        aria-controls="sy-pa-sidebar"
        data-action="sylament--panels--sidebar#toggle"
        aria-label="Open sidebar"
    >
        <twig:SylamentSupport:Icon icon="heroicons:bars-3" />
    </button>

    {% if brandName %}
        <span class="sy-pa-topbar-brand">{{ brandName }}</span>
    {% endif %}

    <div class="sy-pa-topbar-end">
        {{ end }}
    </div>
</header>

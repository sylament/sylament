{% set extraAttributes = group.getExtraAttributeBag.toScalarAttributes %}
{% set rootClasses = classes('sy-ac', extraAttributes.class ?? null) %}
{% set extraAttributes = extraAttributes|filter((value, name) => name != 'class') %}

<twig:SylamentSupport:DropdownItem
    :class="rootClasses"
    :icon="group.getIcon(group.getGroupedIcon)"
    :iconSize="group.getIconSize ?? 'sm'"
    :color="group.getColor"
    {{ ...(group.getTooltip ? {title: group.getTooltip} : {}) }}
    {{ ...extraAttributes }}
>{{- group.getLabel -}}</twig:SylamentSupport:DropdownItem>

{
    "name": "sylament/schemas",
    "description": "Sylament schemas — the component and schema container model Sylament UIs are built from",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Martin Petricko",
            "email": "matopetricko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "doctrine/orm": "^3.7",
        "sylament/actions": "self.version",
        "sylament/support": "self.version",
        "symfony/http-foundation": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/service-contracts": "^3.6",
        "symfony/string": "^8.1",
        "symfony/translation-contracts": "^3.6",
        "symfony/uid": "^8.1",
        "symfony/ux-live-component": "^3.5",
        "symfony/ux-twig-component": "^3.5",
        "symfony/validator": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Sylament\\Schemas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sylament\\Schemas\\Tests\\": "tests/"
        }
    }
}

{% set state = component.getOptionComparisonState %}
{% set stateKeys = (state is iterable ? state : [state])|filter(key => key is not null)|map(key => key ~ '') %}
{% set isInline = component.isInline %}
{% set accessibilityAttributes = component.getAccessibilityAttributes %}
{% set isNativelyRequired = component.isMarkedAsRequired and not component.isConcealed %}

{% set gridAttributes = isInline
    ? null
    : grid(component.getColumns, component.getGridDirection ?? constant('Sylament\\Support\\Enums\\GridDirection::Column')) %}

<twig:SylamentForms:FieldWrapper :field="component" :labelAsHeading="true">
    <div
            {{ attrs({
                class: ['sy', 'sy-fo-radio', {'sy-inline': isInline}],
                role: 'radiogroup',
                'aria-labelledby': component.getLabel is filled ? component.getId ~ '-label' : null,
                'aria-required': component.isRequired and not component.isDisabled ? 'true' : null,
            }, accessibilityAttributes, gridAttributes) }}
    >
        {% for value, label in component.getOptions %}
            {% set isOptionDisabled = component.isDisabled or component.isOptionDisabled(value, label) %}

            <label class="sy-fo-radio-label">
                <input {{ attrs({
                    type: 'radio',
                    class: 'sy-fo-radio-input',
                    id: component.getId ~ '-' ~ value,
                    name: component.getId,
                    value: value,
                    checked: stateKeys has some (key => key is same as (value ~ '')),
                    'data-model': component.getDataModel,
                    disabled: isOptionDisabled,
                    required: isNativelyRequired and not isOptionDisabled,
                    autofocus: loop.first and component.isAutofocused,
                }, accessibilityAttributes, component.getExtraInputAttributes) }}>

                <div class="sy-fo-radio-label-text">
                    <p>{{ label }}</p>

                    {% if component.hasDescription(value) %}
                        <p class="sy-fo-radio-label-description">{{ component.getDescription(value) }}</p>
                    {% endif %}
                </div>
            </label>
        {% endfor %}
    </div>
</twig:SylamentForms:FieldWrapper>

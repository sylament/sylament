{% set breadcrumbs = this.getBreadcrumbs %}
{% set heading = this.getHeading %}
{% set subheading = this.getSubheading %}
{% set headerActions = this.getCachedHeaderActions %}

<div {{ attrs({class: 'sy sy-pa-page sy-pa-resource-create-record-page'}, attributes.all) }}>
    <div class="sy-pa-page-header-main-ctn">
        <twig:SylamentPanels:Header :breadcrumbs="breadcrumbs" :heading="heading" :subheading="subheading">
            <twig:block name="actions">
                {% for action in headerActions %}
                    {{ renderComponent(action) }}
                {% endfor %}
            </twig:block>
        </twig:SylamentPanels:Header>

        <div class="sy-pa-page-main">
            <div class="sy-pa-page-content">
                <form {{ live_action('create:prevent', event: 'submit') }}>
                    {% set recordErrors = this.getErrorsForSchemaStatePath('data') %}

                    {# The schema's own state path belongs to no input, so a record-level refusal
                       that names no field folds here and would otherwise never reach the page. #}
                    {% if recordErrors is not empty %}
                        <ul class="sy-pa-resource-form-errors" data-record-errors>
                            {% for message in recordErrors %}
                                <li>{{ message }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {{ renderSchema('form') }}

                    <div class="sy-pa-resource-form-actions">
                        <twig:SylamentSupport:Button type="submit">Create</twig:SylamentSupport:Button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <twig:SylamentActions:Modals />
</div>

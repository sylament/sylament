{
  "name": "@sylament/schemas",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./utils/*.js": "./src/utils/*.ts"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm test:types && pnpm build:js",
    "build:js": "node scripts/build-js.mjs",
    "watch": "node scripts/build-js.mjs --watch",
    "test:types": "tsc --noEmit"
  },
  "symfony": {
    "controllers": {
      "schema": {
        "main": "dist/controllers/schema_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "tabs": {
        "main": "dist/controllers/tabs_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "wizard": {
        "main": "dist/controllers/wizard_controller.js",
        "fetch": "eager",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@symfony/ux-live-component": "^3.2.0"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@symfony/ux-live-component": "^3.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}

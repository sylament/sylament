{% props
    tag = 'button',
    type = 'button',
    href = null,
    target = null,

    active = false,

    icon = null,
    iconAlias = null,
    iconPosition = 'before',

    badge = null,
    badgeHtml = markup(block('badge') ?? null),
    badgeColor = null,
    badgeIcon = null,
    badgeIconPosition = 'before',
    badgeTooltip = null,

    content = markup(block('content') ?? null)
%}

{% set iconPositionValue = iconPosition.value ?? iconPosition %}
{% set iconHtml = icon ? generateIconHtml(icon, iconAlias) : null %}

<{{ tag }}
    {{ attributes.defaults({
        class: classes('sy sy-tabs-item', {
            'sy-active': active,
        }),
        'aria-current': active ? (tag == 'a' ? 'page' : 'true') : false,
        href: tag == 'a' and href ? href : false,
        target: tag == 'a' and target == '_blank' ? '_blank' : false,
        type: tag == 'button' ? type : false,
    }) }}
>
    {%- if iconHtml and iconPositionValue == 'before' -%}
        {{ iconHtml }}
    {%- endif -%}

    <span class="sy-tabs-item-label">{{- content -}}</span>

    {%- if iconHtml and iconPositionValue == 'after' -%}
        {{ iconHtml }}
    {%- endif -%}

    {%- if badgeHtml -%}
        {{ badgeHtml }}
    {%- elseif badge is filled -%}
        <twig:SylamentSupport:Badge
            size="sm"
            :color="badgeColor ?? 'primary'"
            :icon="badgeIcon"
            :iconPosition="badgeIconPosition"
            {{ ...(badgeTooltip ? {title: badgeTooltip} : {}) }}
        >{{- badge -}}</twig:SylamentSupport:Badge>
    {%- endif -%}
</{{ tag }}>

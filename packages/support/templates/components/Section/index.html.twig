{% props
    afterHeader = markup(block('afterHeader') ?? null),
    aside = false,
    collapseId = null,
    collapseLabel = 'Collapse section',
    collapsed = false,
    collapsible = false,
    compact = false,
    contained = true,
    content = markup(block('content') ?? null),
    contentBefore = false,
    contentId = null,
    description = markup(block('description') ?? null),
    descriptionId = null,
    divided = false,
    expandLabel = 'Expand section',
    footer = markup(block('footer') ?? null),
    hasContentEl = true,
    heading = markup(block('heading') ?? null),
    headingId = null,
    headingTag = 'h2',
    icon = null,
    iconColor = 'gray',
    iconSize = null,
    labelledById = null,
    liveComponentId = null,
    persistCollapsed = false,
    schemaKey = null,
    secondary = false %}

{% set iconColorName = iconColor is iterable or iconColor is empty ? 'gray' : iconColor %}
{% set iconHtml = generateIconHtml(icon, attributes: {
    class: iconColorName != 'gray' ? ['sy-color', 'sy-color-' ~ iconColorName] : [],
}, size: iconSize ?? 'lg') %}

{% set hasAfterHeader = (afterHeader ?? '')|trim is not empty %}
{% set hasIcon = iconHtml is not empty %}
{% set hasHeading = (heading ?? '')|trim is not empty %}
{% set hasDescription = (description ?? '')|trim is not empty %}
{% set hasContent = (content ?? '')|trim is not empty %}
{% set hasFooter = (footer ?? '')|trim is not empty %}
{% set hasHeader = hasIcon or hasHeading or hasDescription or collapsible or hasAfterHeader %}
{% set hasBody = hasContent or hasFooter %}

{% set sectionController = 'sylament--support--section' %}
{% set collapseActions = collapsible ? [
    'collapse-section@window->' ~ sectionController ~ '#collapse',
    'expand-section@window->' ~ sectionController ~ '#expand',
    'open-section@window->' ~ sectionController ~ '#expand',
    'toggle-section@window->' ~ sectionController ~ '#toggle',
    'expand->' ~ sectionController ~ '#reveal',
]|merge(
    not persistCollapsed and liveComponentId and schemaKey
        ? ['reset-schema-component-state@window->' ~ sectionController ~ '#resetState']
        : []
)|join(' ') : false %}

<section
        {{ attributes.defaults({
            class: html_classes('sy sy-section', {
                'sy-section-not-contained': not contained,
                'sy-section-has-header': hasHeader,
                'sy-section-has-content-before': contentBefore,
                'sy-aside': aside,
                'sy-compact': compact,
                'sy-divided': divided,
                'sy-secondary': secondary,
                'sy-collapsible': collapsible,
                'sy-collapsed': collapsible and collapsed
            }),
            'aria-labelledby': labelledById ?: false,
            'aria-describedby': descriptionId ?: false,
            'data-controller': collapsible ? sectionController : false,
            'data-action': collapseActions,
            'data-sylament--support--section-id-value': collapsible and collapseId ? collapseId : false,
            'data-sylament--support--section-collapsed-value': collapsible ? (collapsed ? 'true' : 'false') : false,
            'data-sylament--support--section-persist-value': collapsible and persistCollapsed ? 'true' : false,
            'data-sylament--support--section-expand-label-value': collapsible ? expandLabel : false,
            'data-sylament--support--section-collapse-label-value': collapsible ? collapseLabel : false,
            'data-sylament--support--section-live-component-id-value': collapsible and liveComponentId ? liveComponentId : false,
            'data-sylament--support--section-schema-key-value': collapsible and schemaKey ? schemaKey : false
        }) }}
>
    {% if hasHeader %}
        <header
            {{ html_attr({
                class: ['sy-section-header'],
                'data-action': collapsible ? 'click->' ~ sectionController ~ '#toggleFromHeader' : false,
            }) }}
        >
            {% if hasIcon %}
                {{ iconHtml }}
            {% endif %}

            {% if hasHeading or hasDescription %}
                <div class="sy-section-header-text-ctn">
                    {% if hasHeading %}
                        <{{ headingTag }}
                            {{ html_attr({
                                id: headingId,
                                class: ['sy-section-header-heading'],
                            }) }}
                        >
                            {{ heading }}
                        </{{ headingTag }}>
                    {% endif %}

                    {% if hasDescription %}
                        <p
                            {{ html_attr({
                                id: descriptionId,
                                class: ['sy-section-header-description'],
                            }) }}
                        >
                            {{ description }}
                        </p>
                    {% endif %}
                </div>
            {% endif %}

            {% if hasAfterHeader %}
                <div class="sy-section-header-after-ctn">
                    {{ afterHeader }}
                </div>
            {% endif %}

            {% if collapsible %}
                <twig:SylamentSupport:IconButton
                    color="gray"
                    icon="heroicons:chevron-up"
                    iconAlias="section.collapse-button"
                    class="sy-section-collapse-btn"
                    data-action="{{ 'click->' ~ sectionController ~ '#toggleFromButton' }}"
                    data-sylament--support--section-target="button"
                    aria-label="{{ collapsed ? expandLabel : collapseLabel }}"
                    aria-expanded="{{ collapsed ? 'false' : 'true' }}"
                    :aria-controls="hasBody and contentId ? contentId : false"
                />
            {% endif %}
        </header>
    {% endif %}


    {% if hasBody %}
        <div
            {{ html_attr({
                id: contentId,
                class: html_classes('sy-section-content-ctn', {
                    'sy-cloak': collapsible and persistCollapsed,
                })|split(' '),
                'data-sylament--support--section-target': collapsible ? 'content' : false,
            }) }}
        >
            {% if hasContentEl %}
                <div class="sy-section-content">
                    {{ content }}
                </div>
            {% else %}
                {{ content }}
            {% endif %}

            {% if hasFooter %}
                <footer class="sy-section-footer">
                    {{ footer }}
                </footer>
            {% endif %}
        </div>
    {% endif %}
</section>

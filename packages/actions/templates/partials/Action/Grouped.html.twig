{% set tag = component.getUrl ? 'a' : 'button' %}
{% set iconHtml = component.getIcon(component.getGroupedIcon) ? generateIconHtml(component.getIcon(component.getGroupedIcon), size: component.getIconSize ?? 'sm') : null %}

{% set hasLiveClickBinding = not component.getUrl and not component.canSubmitForm %}

<{{ tag }}
    {{ attrs({
        class: classes('sy sy-dropdown-item sy-ac', {
            'sy-disabled': component.isDisabled,
        }),
        type: component.getUrl ? false : (component.canSubmitForm ? 'submit' : 'button'),
        form: component.getFormId ?: false,
        disabled: component.isDisabled and not component.getUrl,
        'aria-disabled': component.isDisabled ? 'true' : false,
        href: component.getUrl ?: false,
        target: component.shouldOpenUrlInNewTab ? '_blank' : false,
        title: component.getTooltip ?: false,
    }, component.getExtraAttributes) }}
    {%- if not component.getUrl %}
        {%- if hasLiveClickBinding and component.getClientClickHandler %} {{ live_action(component.getClientClickHandler) }}
        {%- elseif hasLiveClickBinding and component.getParentActionCallLiveComponentClickHandler %} {{ live_action(component.getParentActionCallLiveComponentClickHandler, {
            ...(component.getArguments ? {arguments: component.getArguments} : {}),
        }) }}
        {%- elseif component.shouldClose %} data-action="sylament--support--modal#dismiss"
        {%- elseif hasLiveClickBinding %} {{ live_action('mountAction', {
            name: component.getName,
            ...(component.getInvokedArguments ? {arguments: component.getInvokedArguments} : {}),
            ...(component.getContext ? {context: component.getContext} : {}),
        }) }}
        {%- endif %}
    {%- endif %}
>
    {{- iconHtml -}}
    <span class="sy-dropdown-item-label">{{ component.getLabel ?? component.getName }}</span>
</{{ tag }}>

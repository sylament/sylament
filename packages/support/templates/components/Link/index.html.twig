{% props
    tag = 'a',
    type = 'button',
    href = null,
    target = null,
    formId = null,
    disabled = false,

    size = 'md',
    color = 'primary',
    weight = null,

    icon = null,
    iconAlias = null,
    iconSize = null,
    iconPosition = 'before',

    labelSrOnly = false,
    content = markup(block('content') ?? null)
%}

{% set knownSizes = ['xs', 'sm', 'md', 'lg', 'xl'] %}
{% set knownWeights = ['thin', 'extralight', 'light', 'normal', 'medium', 'semibold', 'bold', 'extrabold', 'black'] %}
{% set sizeValue = size.value ?? size %}
{% set weightValue = weight.value ?? weight %}
{% set colorAttrs = colorAttributes('Sylament\\Support\\Colors\\Components\\LinkComponent', color) %}
{% set iconPositionValue = iconPosition.value ?? iconPosition %}
{% set iconSize = iconSize ?? (sizeValue in ['xs', 'sm'] ? 'sm' : null) %}
{% set iconHtml = icon ? generateIconHtml(icon, iconAlias, size: iconSize) : null %}
{% set ariaLabel = labelSrOnly ? (content ?? '')|striptags|trim : null %}

<{{ tag }}
    {{ attributes.without('style').defaults({
        class: classes('sy sy-link', {
            'sy-disabled': disabled,
            ('sy-size-' ~ sizeValue): sizeValue in knownSizes,
            (sizeValue ?? ''): sizeValue is not empty and sizeValue not in knownSizes,
            ('sy-font-' ~ weightValue): weightValue in knownWeights,
            (weightValue ?? ''): weightValue is not empty and weightValue not in knownWeights,
        }, colorAttrs.class),
        style: styles(colorAttrs.style, attributes.all.style ?? null) ?: false,
        'aria-disabled': disabled ? 'true' : false,
        'aria-label': ariaLabel ?: false,
        disabled: disabled and tag == 'button',
        form: formId ?: false,
        href: tag == 'a' and href ? href : false,
        target: tag == 'a' and target == '_blank' ? '_blank' : false,
        type: tag == 'button' ? type : false,
    }) }}
>
    {%- if iconHtml and iconPositionValue == 'before' -%}
        {{ iconHtml }}
    {%- endif -%}
    {%- if not labelSrOnly -%}
        <span class="sy-link-label">{{- content -}}</span>
    {%- endif -%}
    {%- if iconHtml and iconPositionValue == 'after' -%}
        {{ iconHtml }}
    {%- endif -%}
</{{ tag }}>

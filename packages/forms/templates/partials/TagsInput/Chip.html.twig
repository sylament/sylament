{#
    Kept in its own file: `_self` inside a <twig:> block resolves to the embedded component
    template, which carries none of the outer template's macros.
#}
{% macro chip(value, color, prefix, suffix, reorderable, delete_attributes) %}
    <twig:SylamentSupport:Badge
        size="md"
        :color="color"
        :deletable="true"
        :deleteLabel="value is empty ? 'Delete' : 'Delete: ' ~ value"
        :deleteAttributes="delete_attributes"
        :data-value="value"
        {{ ...(reorderable ? {class: 'sy-reorderable', 'data-sortable-item': value, 'data-sortable-handle': true} : {}) }}
    >{{ prefix }}<span class="sy-fo-tags-input-tag-label">{{ value }}</span>{{ suffix }}</twig:SylamentSupport:Badge>
{% endmacro chip %}

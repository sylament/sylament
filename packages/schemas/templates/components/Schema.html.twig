{% set isInline = component.isInline %}
{% set alignmentClass = component.getAlignmentClass %}

<div
        {{ attrs({
            class: [
                'sy sy-sc',
                isInline ? 'sy-inline' : null,
                alignmentClass,
                {
                    'sy-sc-has-gap': component.hasGap,
                    'sy-sc-dense': component.isDense,
                },
            ],
        }, isInline ? null : grid(component.getColumns), component.getExtraAttributes) }}
>
    {% for childComponent in component.getComponents(true, false) %}
        <div {{ attrs(
            isInline ? null : gridColumn(childComponent.getColumnSpan, childComponent.getColumnStart, childComponent.getColumnOrder),
            isInline and childComponent.canGrow(false) ? { class: ['sy-growable'] } : null,
        ) }}>
            <div class="sy-sc-component">
                {{ renderComponent(childComponent) }}
            </div>
        </div>
    {% endfor %}
</div>

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ pageTitle }}{% if panel.getBrandName %} — {{ panel.getBrandName }}{% endif %}{% endblock title %}</title>

        <script>
            (() => {
                let theme = null;
                try { theme = window.localStorage.getItem('sylament.theme'); } catch {}
                if (theme === 'dark' || (theme !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.documentElement.classList.add('dark');
                }
            })();
        </script>

        {% block stylesheets %}
            {{ sylamentStyles() }}
        {% endblock stylesheets %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock importmap %}
        {% endblock javascripts %}
    </head>
    <body {{ attrs(bodyAttributes) }}>
        {% if layout == 'SylamentPanels:SimpleLayout' %}
            <twig:SylamentPanels:SimpleLayout :hasTopbar="hasTopbar" :maxContentWidthClass="maxContentWidthClass">
                <twig:block name="content">
                    {{ component(componentName, componentProps) }}
                </twig:block>
            </twig:SylamentPanels:SimpleLayout>
        {% else %}
            <twig:SylamentPanels:Layout
                :navigation="panel.getNavigation"
                :brandName="panel.getBrandName"
                :brandLogo="panel.getBrandLogo"
                :darkModeBrandLogo="panel.getDarkModeBrandLogo"
                :brandLogoHeight="panel.getBrandLogoHeight"
                :hasGlobalSearch="panel.isGlobalSearchEnabled"
                :maxContentWidthClass="maxContentWidthClass"
            >
                <twig:block name="content">
                    {{ component(componentName, componentProps) }}
                </twig:block>
            </twig:SylamentPanels:Layout>
        {% endif %}

        <twig:SylamentNotifications:Notifications />
    </body>
</html>

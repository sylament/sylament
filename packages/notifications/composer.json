{
    "name": "sylament/notifications",
    "description": "Sylament notifications — notifications for the Sylament UI toolkit",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Martin Petricko",
            "email": "matopetricko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "sylament/actions": "self.version",
        "sylament/support": "self.version",
        "symfony/event-dispatcher": "^8.1",
        "symfony/html-sanitizer": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/service-contracts": "^3.6",
        "symfony/uid": "^8.1",
        "symfony/ux-live-component": "^3.1",
        "symfony/ux-twig-component": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Sylament\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sylament\\Notifications\\Tests\\": "tests/"
        }
    }
}

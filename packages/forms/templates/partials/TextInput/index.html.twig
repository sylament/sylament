{% set datalistOptions = component.getDatalistOptions %}

<twig:SylamentForms:FieldWrapper :field="component">
    <input {{ attrs({
        class: 'sy-fo-input',
        type: component.getType,
        id: component.getId,
        name: component.getName,
        'data-model': component.getDataModel,
        value: component.getState ?? '',
        inputmode: component.getInputMode ?: false,
        autocapitalize: component.getAutocapitalize,
        autocomplete: component.getAutocomplete,
        placeholder: component.getPlaceholder ?: false,
        maxlength: component.getMaxLength,
        minlength: component.getMinLength,
        max: component.getMaxValue,
        min: component.getMinValue,
        step: component.getStep,
        list: datalistOptions ? component.getId ~ '-list' : null,
        required: component.isMarkedAsRequired,
        'aria-invalid': component.getErrorMessages is not empty,
        readonly: component.isReadOnly,
        disabled: component.isDisabled,
        autofocus: component.isAutofocused,
    }, component.getExtraInputAttributes) }}>

    {% if datalistOptions %}
        <datalist id="{{ component.getId }}-list">
            {% for option in datalistOptions %}
                <option value="{{ option }}"></option>
            {% endfor %}
        </datalist>
    {% endif %}
</twig:SylamentForms:FieldWrapper>

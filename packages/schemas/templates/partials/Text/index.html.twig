{% set sizeClass = component.getSizeClass %}
{% set weightClass = component.getWeightClass %}
{% set fontFamilyClass = component.getFontFamilyClass %}
{% set colorAttrs = colorAttributes('Sylament\\Schemas\\Colors\\Components\\TextComponent', component.getColor) %}

<span
        {{ attrs({
            class: ['sy', 'sy-sc-text', sizeClass, weightClass, fontFamilyClass, colorAttrs.class],
            style: colorAttrs.style,
        }, component.getExtraAttributes) }}
>
    {{- component.getContent -}}
</span>

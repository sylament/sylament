{% set label = component.getLabel %}
{% set id = component.getId %}

<div
        {{ attrs({
            class: ['sy', 'sy-fo-field'],
        }, component.getExtraAttributes) }}
>
    {% if label is not null and component.isLabelHidden %}
        <label for="{{ id }}" class="sy-fo-field-label sy-fo-sr-only">{{ label }}</label>
    {% elseif label is not null %}
        <label for="{{ id }}" class="sy-fo-field-label">
            <span class="sy-fo-field-label-content">{{ label }}{% if component.isMarkedAsRequired %}<sup class="sy-fo-field-label-required-mark">*</sup>{% endif %}</span>
        </label>

        {% if component.hasHint or component.hasHintIcon %}
            <span class="sy-fo-field-hint">
                {%- if component.hasHint %}{{ component.getHint }}{% endif -%}
                {%- if component.hasHintIcon %}{{ generateIconHtml(component.getHintIcon, attributes: {
                    class: 'sy-fo-field-hint-icon',
                    ...(component.getHintIconTooltip ? { title: component.getHintIconTooltip } : {}),
                }, size: 'sm') }}{% endif -%}
            </span>
        {% endif %}
    {% endif %}

    {% block content %}{% endblock %}

    {% if component.getHelperText is not empty %}
        <div class="sy-fo-field-helper">{{ component.getHelperText }}</div>
    {% endif %}

    {% if component.getErrorMessages is not empty %}
        <ul data-validation-error class="sy-fo-field-error-list">
            {% for message in component.getErrorMessages %}
                <li class="sy-fo-field-error-message">{{ message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
</div>

{
  "name": "@sylament/support",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm test:types && pnpm build:js && pnpm build:css",
    "build:js": "node scripts/build-js.mjs",
    "build:css": "node scripts/copy-fonts.mjs && node scripts/scope-preflight.mjs && node scripts/scope-vendor-css.mjs && tailwindcss -i src/styles/index.css -o dist/styles/index.css --minify",
    "watch": "concurrently -n js,css -c blue,green \"pnpm watch:js\" \"pnpm watch:css\"",
    "watch:js": "node scripts/build-js.mjs --watch",
    "watch:css": "node scripts/copy-fonts.mjs && node scripts/scope-preflight.mjs && node scripts/scope-vendor-css.mjs && tailwindcss -i src/styles/index.css -o dist/styles/index.css --watch",
    "test:types": "tsc --noEmit"
  },
  "symfony": {
    "controllers": {
      "core": {
        "main": "dist/controllers/core_controller.js",
        "fetch": "eager",
        "enabled": true,
        "autoimport": {
          "@sylament/support/styles/index.css": true
        }
      },
      "section": {
        "main": "dist/controllers/section_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "sortable": {
        "main": "dist/controllers/sortable_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "modal": {
        "main": "dist/controllers/modal_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "dropdown": {
        "main": "dist/controllers/dropdown_controller.js",
        "fetch": "eager",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "sortablejs": "^1.15.7"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/sortablejs": "^1.15.9",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}

{% set label = component.getLabel %}

{% set hasLabel = label is filled %}

<div
        {{ attrs({
            class: ['sy', 'sy-sc-section'],
        }, component.getExtraAttributes, id ? { id: id } : null) }}
>
    {% if hasLabel %}
        <div class="sy-sc-section-label-ctn">
            {{ renderComponent(beforeLabelSchema) }}

            <div
                    {{ attrs({
                        id: labelId,
                        class: ['sy-sc-section-label', {
                            'sy-sc-section-label-hidden': component.isLabelHidden,
                        }],
                    }) }}
            >
                {{ label }}
            </div>

            {{ renderComponent(afterLabelSchema) }}
        </div>
    {% endif %}

    {{ renderComponent(aboveContentSchema) }}

    <twig:SylamentSupport:Section
            :heading="component.getHeading"
            :description="component.getDescription"
            :collapseId="id"
            :collapsed="component.isCollapsed"
            :collapsible="collapsible"
            :compact="component.isCompact"
            :contained="component.isContained"
            :contentBefore="component.hasContentBefore"
            :contentId="contentId"
            :descriptionId="descriptionId"
            :divided="component.isDivided"
            :hasContentEl="false"
            :headingId="headingId"
            :headingTag="component.getHeadingTag"
            :icon="component.getIcon"
            :iconColor="component.getIconColor"
            :iconSize="component.getIconSize"
            :labelledById="labelledById"
            :persistCollapsed="component.shouldPersistCollapsed"
            :secondary="component.isSecondary"
            :aside="component.isAside"
    >
        <twig:block name="afterHeader">
            {{ renderComponent(afterHeaderSchema) }}
        </twig:block>

        <twig:block name="content">
            {{ renderComponent(contentSchema) }}
        </twig:block>

        <twig:block name="footer">
            {{ renderComponent(footerSchema) }}
        </twig:block>
    </twig:SylamentSupport:Section>

    {{ renderComponent(belowContentSchema) }}
</div>

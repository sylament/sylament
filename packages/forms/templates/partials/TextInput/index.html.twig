{% set controller = 'sylament--forms--text-input' %}

{% set datalistOptions = component.getDatalistOptions %}
{% set isPasswordRevealable = component.isPasswordRevealable %}
{% set isCopyable = component.isCopyable %}
{% set hasController = isPasswordRevealable or isCopyable %}

{% set prefixActions = component.getPrefixActions %}
{% set suffixActions = component.getSuffixActions %}
{% set hasInlinePrefix = component.isPrefixInline and (prefixActions|length > 0 or component.getPrefixIcon or component.getPrefixLabel is filled) %}
{% set hasInlineSuffix = component.isSuffixInline and (suffixActions|length > 0 or component.getSuffixIcon or component.getSuffixLabel is filled) %}

<twig:SylamentForms:FieldWrapper :field="component">
    <twig:SylamentSupport:InputWrapper
        class="sy-fo-text-input"
        :disabled="component.isDisabled"
        :valid="component.getErrorMessages is empty"
        :inlinePrefix="component.isPrefixInline"
        :inlineSuffix="component.isSuffixInline"
        :prefix="component.getPrefixLabel"
        :prefixActions="prefixActions"
        :prefixIcon="component.getPrefixIcon"
        :prefixIconColor="component.getPrefixIconColor ?? 'gray'"
        :suffix="component.getSuffixLabel"
        :suffixActions="suffixActions"
        :suffixIcon="component.getSuffixIcon"
        :suffixIconColor="component.getSuffixIconColor ?? 'gray'"
        {{ ...(hasController ? stimulus_controller(controller) : {}) }}
    >
        <input {{ attrs({
            class: ['sy-fo-input', {
                'sy-fo-input-has-inline-prefix': hasInlinePrefix,
                'sy-fo-input-has-inline-suffix': hasInlineSuffix,
                'sy-revealable': isPasswordRevealable,
            }],
            type: component.getType,
            id: component.getId,
            name: component.getName,
            'data-model': component.getDataModel,
            value: component.getState ?? '',
            inputmode: component.getInputMode ?: false,
            autocapitalize: component.getAutocapitalize,
            autocomplete: component.getAutocomplete,
            placeholder: component.getPlaceholder ?: false,
            maxlength: component.isConcealed ? null : component.getMaxLength,
            minlength: component.isConcealed ? null : component.getMinLength,
            max: component.isConcealed ? null : component.getMaxValue,
            min: component.isConcealed ? null : component.getMinValue,
            step: component.getStep,
            list: datalistOptions ? component.getId ~ '-list' : null,
            required: component.isMarkedAsRequired and not component.isConcealed,
            'aria-invalid': component.getErrorMessages is not empty,
            readonly: component.isReadOnly,
            disabled: component.isDisabled,
            autofocus: component.isAutofocused,
        }, component.getExtraInputAttributes, hasController ? stimulus_target(controller, 'input') : null) }}>

        {% if isCopyable %}
            <span {{ attrs({
                class: ['sy-fo-text-input-copy-message'],
                role: 'status',
                'aria-live': 'polite',
            }, stimulus_target(controller, 'copyMessage')) }}></span>
        {% endif %}

        {% if datalistOptions %}
            <datalist id="{{ component.getId }}-list">
                {% for option in datalistOptions %}
                    <option value="{{ option }}"></option>
                {% endfor %}
            </datalist>
        {% endif %}
    </twig:SylamentSupport:InputWrapper>
</twig:SylamentForms:FieldWrapper>

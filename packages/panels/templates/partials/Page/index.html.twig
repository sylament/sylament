{% set breadcrumbs = this.getBreadcrumbs %}
{% set heading = this.getHeading %}
{% set subheading = this.getSubheading %}
{% set headerActions = this.getCachedHeaderActions %}
{% set headerActionsAlignment = this.getHeaderActionsAlignment %}

{% set subNavigation = this.getCachedSubNavigation %}
{% set subNavigationPosition = subNavigation is not empty ? this.getSubNavigationPosition : null %}

{% set hasUnsavedDataChangesAlert = this.hasUnsavedDataChangesAlert %}
{% set guardsActionChanges = this.getPanel.hasUnsavedChangesAlerts %}
{% set savedDataHash = hasUnsavedDataChangesAlert ? this.savedDataHash : null %}

<div
    {{ attrs({
        class: ['sy sy-pa-page', this.getPageClasses, {
            'sy-pa-page-has-sub-navigation': subNavigation is not empty,
            ('sy-pa-page-has-sub-navigation-' ~ (subNavigationPosition.value ?? '')): subNavigationPosition is not null,
        }],
    }, attributes.all) }}
>
    <div class="sy-pa-page-header-main-ctn">
        {% block header %}
            {% if headerActions is not empty or breadcrumbs is not empty or heading is filled or subheading is filled %}
                <twig:SylamentPanels:Header :breadcrumbs="breadcrumbs" :heading="heading" :subheading="subheading">
                    <twig:block name="actions">
                        {% for action in headerActions %}
                            {{ renderComponent(action) }}
                        {% endfor %}
                    </twig:block>
                </twig:SylamentPanels:Header>
            {% endif %}
        {% endblock header %}

        <div class="sy-pa-page-main">
            {% if subNavigation is not empty %}
                <twig:SylamentPanels:SubNavigation :navigation="subNavigation" :position="subNavigationPosition" />
            {% endif %}

            <div class="sy-pa-page-content">
                {% block content %}{{ renderSchema('content') }}{% endblock content %}
            </div>

            {% if subNavigation is not empty %}
                <twig:SylamentPanels:SubNavigation :navigation="subNavigation" :position="subNavigationPosition" :end="true" />
            {% endif %}
        </div>

        {% block footer %}{% endblock footer %}
    </div>

    <twig:SylamentActions:Modals />

    {% if hasUnsavedDataChangesAlert or guardsActionChanges %}
        <div class="sy-pa-unsaved-changes" {{ stimulus_controller('sylament--panels--unsaved-changes', {
            savedHash: savedDataHash ?? '',
            dataModel: hasUnsavedDataChangesAlert ? 'data' : '',
            guardActions: guardsActionChanges,
        }) }}></div>
    {% endif %}
</div>

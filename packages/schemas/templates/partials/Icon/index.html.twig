{% set color = component.getColor %}
{% set colorName = color is iterable or color is empty ? 'gray' : color %}
{% set tooltip = component.getTooltip %}

{{ generateIconHtml(component.getIcon, attributes: {
    class: colorName != 'gray' ? ['sy-sc-icon', 'sy-color', 'sy-color-' ~ colorName] : ['sy-sc-icon'],
    ...(tooltip ? { title: tooltip } : {}),
}, size: component.getSize) }}

{% set hasLiveClickBinding = not component.getUrl and not component.canSubmitForm %}
{% set clickParameters = null %}
{% set closeAttributes = {} %}
{%- if not component.getUrl -%}
    {%- if hasLiveClickBinding and component.getClientClickHandler -%}
        {%- set clickParameters = {action: component.getClientClickHandler} -%}
    {%- elseif hasLiveClickBinding and component.getParentActionCallLiveComponentClickHandler -%}
        {%- set clickParameters = {
            action: component.getParentActionCallLiveComponentClickHandler,
            ...(component.getArguments ? {arguments: component.getArguments} : {}),
        } -%}
    {%- elseif component.shouldClose -%}
        {%- set closeAttributes = {'data-action': 'sylament--support--modal#dismiss'} -%}
    {%- elseif hasLiveClickBinding -%}
        {%- set clickParameters = {
            action: 'mountAction',
            name: component.getName,
            ...(component.getInvokedArguments ? {arguments: component.getInvokedArguments} : {}),
            ...(component.getContext ? {context: component.getContext} : {}),
        } -%}
    {%- endif -%}
{%- endif -%}

{% set mountAttributes = clickParameters is null
    ? {}
    : stimulus_action('live', 'action', parameters: clickParameters) %}

{% set extraAttributes = component.getExtraAttributeBag.toScalarAttributes %}
{% set rootClasses = classes('sy-ac', extraAttributes.class ?? null) %}
{% set extraAttributes = extraAttributes|filter((value, name) => name != 'class') %}

<twig:SylamentSupport:Badge
    :class="rootClasses"
    :icon="component.getIcon"
    :iconSize="component.getIconSize"
    :iconPosition="component.getIconPosition"
    :color="component.getColor"
    :size="component.getSize ?? 'md'"
    :disabled="component.isDisabled"
    :tag="component.getUrl ? 'a' : 'button'"
    :href="component.getUrl"
    :target="component.shouldOpenUrlInNewTab ? '_blank' : null"
    :type="component.canSubmitForm ? 'submit' : 'button'"
    :formId="component.getFormId"
    :labelSrOnly="component.isLabelHidden"
    {{ ...(component.getTooltip ? {title: component.getTooltip} : {}) }}
    {{ ...extraAttributes }}
    {{ ...mountAttributes }}
    {{ ...closeAttributes }}
>{{- component.getLabel ?? component.getName -}}</twig:SylamentSupport:Badge>

{
    "name": "sylament/actions",
    "description": "Sylament actions — actions for the Sylament UI toolkit",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Martin Petricko",
            "email": "matopetricko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "sylament/schemas": "self.version",
        "sylament/support": "self.version",
        "symfony/property-access": "^8.1",
        "symfony/string": "^8.1",
        "symfony/ux-live-component": "^3.1",
        "symfony/ux-twig-component": "^3.1"
    },
    "suggest": {
        "sylament/tables": "Resolves mounted actions from a table context and binds their records."
    },
    "autoload": {
        "psr-4": {
            "Sylament\\Actions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sylament\\Actions\\Tests\\": "tests/"
        }
    }
}

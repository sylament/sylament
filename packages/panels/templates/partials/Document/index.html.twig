<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ pageTitle }}{% if panel.getBrandName %} — {{ panel.getBrandName }}{% endif %}{% endblock title %}</title>

        <script>
            (() => {
                let theme = null;
                try { theme = window.localStorage.getItem('sylament.theme'); } catch {}
                if (theme === 'dark' || (theme !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.documentElement.classList.add('dark');
                }
            })();
        </script>

        {% block stylesheets %}
            {{ sylamentStyles() }}
        {% endblock stylesheets %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock importmap %}
        {% endblock javascripts %}
    </head>
    <body>
        <twig:SylamentPanels:Layout :navigation="panel.getNavigation" :brandName="panel.getBrandName">
            <twig:block name="content">
                {{ component(componentName, componentProps) }}
            </twig:block>
        </twig:SylamentPanels:Layout>

        <twig:SylamentNotifications:Notifications />
    </body>
</html>

{% props
    brandName = null,

    end = markup(block('end') ?? null)
%}

{% set hasEnd = end is filled %}

{% set sidebarController = 'sylament--panels--sidebar' %}

<header
    {{ attrs({
        id: 'sy-pa-topbar',
        class: 'sy sy-pa-topbar',
    }, attributes.all) }}
>
    <button
        {{ attrs({
            type: 'button',
            class: 'sy-pa-topbar-open-sidebar-btn',
            'aria-controls': 'sy-pa-sidebar',
            'aria-expanded': 'false',
            'aria-label': 'Toggle sidebar',
        }, stimulus_action(sidebarController, 'toggle')|stimulus_target(sidebarController, 'toggleButton')) }}
    >
        <twig:SylamentSupport:Icon icon="heroicons:bars-3" :alias="constant('Sylament\\Panels\\Twig\\PanelsIconAlias::TOPBAR_OPEN_SIDEBAR_BUTTON')" />
    </button>

    {% if brandName %}
        <span class="sy-pa-topbar-brand">{{ brandName }}</span>
    {% endif %}

    {% if hasEnd %}
        <div class="sy-pa-topbar-end">
            {{ end }}
        </div>
    {% endif %}
</header>

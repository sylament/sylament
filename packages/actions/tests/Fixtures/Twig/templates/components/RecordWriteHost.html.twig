<div {{ attributes }}>
    {{ renderComponent(this.createAction()) }}
    {{ renderComponent(this.createWithHookAction()) }}
    {{ renderComponent(this.createPreservingAction()) }}
    {{ renderComponent(this.editAction()) }}
    {{ renderComponent(this.editMutatedAction()) }}
    {{ renderComponent(this.editArrayAction()) }}
    {{ renderComponent(this.replicateAction()) }}
    {{ renderComponent(this.replicateBareAction()) }}
    {{ renderComponent(this.viewAction()) }}

    <twig:SylamentActions:Modals />
</div>

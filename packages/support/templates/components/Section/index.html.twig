{% props
    afterHeader = markup(block('afterHeader') ?? null),
    aside = false,
    compact = false,
    contained = true,
    content = markup(block('content') ?? null),
    contentBefore = false,
    contentId = null,
    description = markup(block('description') ?? null),
    descriptionId = null,
    divided = false,
    footer = markup(block('footer') ?? null),
    hasContentEl = true,
    heading = markup(block('heading') ?? null),
    headingId = null,
    headingTag = 'h2',
    labelledById = null,
    secondary = false %}

{% set hasAfterHeader = (afterHeader ?? '')|trim is not empty %}
{% set hasHeading = (heading ?? '')|trim is not empty %}
{% set hasDescription = (description ?? '')|trim is not empty %}
{% set hasContent = (content ?? '')|trim is not empty %}
{% set hasFooter = (footer ?? '')|trim is not empty %}
{% set hasHeader = hasHeading or hasDescription or hasAfterHeader %}
{% set hasBody = hasContent or hasFooter %}

<section
        {{ attributes.defaults({
            class: html_classes('sy sy-section', {
                'sy-section-not-contained': not contained,
                'sy-section-has-header': hasHeader,
                'sy-section-has-content-before': contentBefore,
                'sy-aside': aside,
                'sy-compact': compact,
                'sy-divided': divided,
                'sy-secondary': secondary
            }),
            'aria-labelledby': labelledById ?: false,
            'aria-describedby': descriptionId ?: false
        }) }}
>
    {% if hasHeader %}
        <header class="sy-section-header">
            {# TODO: add section icon #}

            {% if hasHeading or hasDescription %}
                <div class="sy-section-header-text-ctn">
                    {% if hasHeading %}
                        <{{ headingTag }}
                            {{ html_attr({
                                id: headingId,
                                class: ['sy-section-header-heading'],
                            }) }}
                        >
                            {{ heading }}
                        </{{ headingTag }}>
                    {% endif %}

                    {% if hasDescription %}
                        <p
                            {{ html_attr({
                                id: descriptionId,
                                class: ['sy-section-header-description'],
                            }) }}
                        >
                            {{ description }}
                        </p>
                    {% endif %}
                </div>
            {% endif %}

            {% if hasAfterHeader %}
                <div class="sy-section-header-after-ctn">
                    {{ afterHeader }}
                </div>
            {% endif %}
        </header>
    {% endif %}


    {% if hasBody %}
        <div
            {{ html_attr({
                id: contentId,
                class: ['sy-section-content-ctn'],
            }) }}
        >
            {% if hasContentEl %}
                <div class="sy-section-content">
                    {{ content }}
                </div>
            {% else %}
                {{ content }}
            {% endif %}

            {% if hasFooter %}
                <footer class="sy-section-footer">
                    {{ footer }}
                </footer>
            {% endif %}
        </div>
    {% endif %}
</section>

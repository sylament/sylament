{% props
    label = null,

    contained = false,
    vertical = false
%}

<nav
    {{ attributes.defaults({
        class: classes('sy sy-tabs', {
            'sy-contained': contained,
            'sy-vertical': vertical,
        }),
        'aria-label': label ?? ('components.tabs.label'|trans(domain: 'sylament')),
    }) }}
>
    {% block content %}{% endblock content %}
</nav>

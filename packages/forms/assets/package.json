{
  "name": "@sylament/forms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm test:types && pnpm build:js",
    "build:js": "node scripts/copy-licenses.mjs && node scripts/build-js.mjs",
    "watch": "node scripts/build-js.mjs --watch",
    "test:types": "tsc --noEmit"
  },
  "symfony": {
    "controllers": {
      "checkbox-list": {
        "main": "dist/controllers/checkbox_list_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "select": {
        "main": "dist/controllers/select_controller.js",
        "fetch": "eager",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "dependencies": {
    "tom-select": "^2.6.2"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@symfony/ux-live-component": "^3.2.0"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@symfony/ux-live-component": "^3.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}

{
  "name": "@sylament/panels",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm test:types && pnpm build:js",
    "build:js": "node scripts/build-js.mjs",
    "watch": "node scripts/build-js.mjs --watch",
    "test:types": "tsc --noEmit"
  },
  "symfony": {
    "controllers": {
      "global-search": {
        "main": "dist/controllers/global_search_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "sidebar": {
        "main": "dist/controllers/sidebar_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "theme": {
        "main": "dist/controllers/theme_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "unsaved-changes": {
        "main": "dist/controllers/unsaved_changes_controller.js",
        "fetch": "eager",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@symfony/ux-live-component": "^3.2.0"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@symfony/ux-live-component": "^3.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}

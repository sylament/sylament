{% set knownSizes = ['xs', 'sm', 'md', 'lg', 'xl'] %}
{% set sizeValue = component.getSize.value ?? component.getSize %}
{% set colorName = component.getColor is iterable or component.getColor is empty ? 'gray' : component.getColor %}
{% set tag = component.getUrl ? 'a' : 'button' %}
{% set iconHtml = component.getIcon ? generateIconHtml(component.getIcon, null, null, component.getIconSize ?? (sizeValue in ['xs', 'sm'] ? 'sm' : null)) : null %}

<{{ tag }}
    {{ attrs({
        class: classes('sy sy-ac-link sy-ac', {
            'sy-disabled': component.isDisabled,
            ('sy-size-' ~ sizeValue): sizeValue in knownSizes,
            (sizeValue ?? ''): sizeValue is not empty and sizeValue not in knownSizes,
            'sy-color': colorName != 'gray',
            ('sy-color-' ~ colorName): colorName != 'gray',
        }),
        type: component.getUrl ? false : 'button',
        disabled: component.isDisabled and not component.getUrl,
        'aria-disabled': component.isDisabled ? 'true' : false,
        'aria-label': component.isLabelHidden ? (component.getLabel ?? component.getName)|striptags|trim : false,
        href: component.getUrl ?: false,
        target: component.shouldOpenUrlInNewTab ? '_blank' : false,
        title: component.getTooltip ?: false,
    }, component.getExtraAttributes) }}
    {%- if not component.getUrl %}
        {%- if component.getClientClickHandler %} {{ live_action(component.getClientClickHandler) }}
        {%- elseif component.getParentActionCallLiveComponentClickHandler %} {{ live_action(component.getParentActionCallLiveComponentClickHandler, {
            ...(component.getArguments ? { arguments: component.getArguments } : {}),
        }) }}
        {%- elseif component.shouldClose %} data-action="sylament--support--modal#dismiss"
        {%- else %} {{ live_action('mountAction', {
            name: component.getName,
            ...(component.getInvokedArguments ? { arguments: component.getInvokedArguments } : {}),
            ...(component.getContext ? { context: component.getContext } : {}),
        }) }}
        {%- endif %}
    {%- endif %}
>
    {%- if iconHtml and component.getIconPosition.value == 'before' %}{{ iconHtml }}{% endif -%}
    {%- if not component.isLabelHidden %}{{ component.getLabel ?? component.getName }}{% endif -%}
    {%- if iconHtml and component.getIconPosition.value == 'after' %}{{ iconHtml }}{% endif -%}
</{{ tag }}>

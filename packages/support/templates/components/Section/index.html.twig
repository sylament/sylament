{% props
    schemaKey = null,
    liveComponentId = null,

    heading = markup(block('heading') ?? null),
    headingTag = 'h2',
    description = markup(block('description') ?? null),
    icon = null,
    iconColor = 'gray',
    iconSize = null,
    afterHeader = markup(block('afterHeader') ?? null),

    content = markup(block('content') ?? null),
    contentBefore = false,
    hasContentEl = true,

    footer = markup(block('footer') ?? null),

    collapsible = false,
    collapsed = false,
    persistCollapsed = false,
    collapseLabel = 'Collapse section',
    expandLabel = 'Expand section',

    aside = false,
    compact = false,
    contained = true,
    divided = false,
    secondary = false,

    headingId = null,
    descriptionId = null,
    contentId = null,
    collapseId = null,
    labelledById = null
%}

{% set iconColorAttrs = colorAttributes('Sylament\\Support\\Colors\\Components\\SectionComponent\\IconComponent', iconColor) %}
{% set iconHtml = generateIconHtml(icon, attributes: {
    class: iconColorAttrs.class,
    style: iconColorAttrs.style,
}, size: iconSize ?? 'lg') %}

{% set hasAfterHeader = afterHeader is filled %}
{% set hasIcon = iconHtml is not empty %}
{% set hasHeading = heading is filled %}
{% set hasDescription = description is filled %}
{% set hasContent = content is filled %}
{% set hasFooter = footer is filled %}
{% set hasHeader = hasIcon or hasHeading or hasDescription or collapsible or hasAfterHeader %}
{% set hasBody = hasContent or hasFooter %}

{% set sectionController = 'sylament--support--section' %}
{% set sectionStimulus = collapsible ? stimulus_controller(sectionController, {
    id: collapseId ?: null,
    collapsed: collapsed,
    persist: persistCollapsed ? true : null,
    expandLabel: expandLabel,
    collapseLabel: collapseLabel,
    liveComponentId: liveComponentId ?: null,
    schemaKey: schemaKey ?: null,
})
    |stimulus_action(sectionController, 'collapse', 'collapse-section@window')
    |stimulus_action(sectionController, 'expand', 'expand-section@window')
    |stimulus_action(sectionController, 'expand', 'open-section@window')
    |stimulus_action(sectionController, 'toggle', 'toggle-section@window')
    |stimulus_action(sectionController, 'reveal', 'expand') : null %}

{% if sectionStimulus and not persistCollapsed and liveComponentId and schemaKey %}
    {% set sectionStimulus = sectionStimulus|stimulus_action(sectionController, 'resetState', 'reset-schema-component-state@window') %}
{% endif %}

<section
        {{ attributes.defaults({
            class: classes('sy sy-section', {
                'sy-section-not-contained': not contained,
                'sy-section-has-header': hasHeader,
                'sy-section-has-content-before': contentBefore,
                'sy-aside': aside,
                'sy-compact': compact,
                'sy-divided': divided,
                'sy-secondary': secondary,
                'sy-collapsible': collapsible,
                'sy-collapsed': collapsible and collapsed,
            }),
            'aria-labelledby': labelledById ?: null,
            'aria-describedby': descriptionId ?: null,
            ...(sectionStimulus ?: {}),
        }) }}
>
    {% if hasHeader %}
        <header
                {{ attrs({
                    class: ['sy-section-header'],
                    ...(collapsible ? stimulus_action(sectionController, 'toggleFromHeader', 'click') : {}),
                }) }}
        >
            {% if hasIcon %}
                {{ iconHtml }}
            {% endif %}

            {% if hasHeading or hasDescription %}
                <div class="sy-section-header-text-ctn">
                {% if hasHeading %}
                    <{{ headingTag }}
                        {{ attrs({
                            id: headingId,
                            class: ['sy-section-header-heading'],
                        }) }}
                    >
                        {{ heading }}
                    </{{ headingTag }}>
                {% endif %}

                {% if hasDescription %}
                    <p
                        {{ attrs({
                            id: descriptionId,
                            class: ['sy-section-header-description'],
                        }) }}
                    >
                        {{ description }}
                    </p>
                {% endif %}
                </div>
            {% endif %}

            {% if hasAfterHeader %}
                <div class="sy-section-header-after-ctn">
                    {{ afterHeader }}
                </div>
            {% endif %}

            {% if collapsible %}
                <twig:SylamentSupport:IconButton
                        color="gray"
                        icon="heroicons:chevron-up-20-solid"
                        iconAlias="section.collapse-button"
                        class="sy-section-collapse-btn"
                        {{ ...(stimulus_action(sectionController, 'toggleFromButton', 'click')|stimulus_target(sectionController, 'button')) }}
                        :aria-label="collapsed ? expandLabel : collapseLabel"
                        :aria-expanded="collapsed ? 'false' : 'true'"
                        :aria-controls="hasBody and contentId ? contentId : null"
                />
            {% endif %}
        </header>
    {% endif %}

    {% if hasBody %}
        <div
                {{ attrs({
                    id: contentId,
                    class: ['sy-section-content-ctn', {
                        'sy-cloak': collapsible and persistCollapsed,
                    }],
                    ...(collapsible ? stimulus_target(sectionController, 'content') : {}),
                }) }}
        >
            {% if hasContentEl %}
                <div class="sy-section-content">
                    {{ content }}
                </div>
            {% else %}
                {{ content }}
            {% endif %}

            {% if hasFooter %}
                <footer class="sy-section-footer">
                    {{ footer }}
                </footer>
            {% endif %}
        </div>
    {% endif %}
</section>

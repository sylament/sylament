<div
        {{ html_attr({
            class: html_classes('sy sy-sc', {
                'sy-sc-has-gap': component.hasGap,
                'sy-sc-dense': component.isDense,
            })|split(' '),
        }, grid(component.getColumns), component.getExtraAttributes) }}
>
    {% for childComponent in component.getComponents %}
        <div {{ html_attr(gridColumn(childComponent.getColumnSpan, childComponent.getColumnStart, childComponent.getColumnOrder)) }}>
            <div class="sy-sc-component">
                {{ renderComponent(childComponent) }}
            </div>
        </div>
    {% endfor %}
</div>

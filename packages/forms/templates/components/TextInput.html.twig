{% embed '@SylamentForms/components/field-wrapper.html.twig' %}
    {% block content %}
        <input
                class="sy-fo-input"
                type="{{ component.getType }}"
                id="{{ component.getId }}"
                name="{{ component.getName }}"
                data-model="{{ component.getDataModel }}"
                {%- if component.getInputMode %} inputmode="{{ component.getInputMode }}"{% endif %}
                {%- if component.getPlaceholder %} placeholder="{{ component.getPlaceholder }}"{% endif %}
                {%- if component.getMaxLength is not null %} maxlength="{{ component.getMaxLength }}"{% endif %}
                {%- if component.getMinLength is not null %} minlength="{{ component.getMinLength }}"{% endif %}
                {%- if component.isMarkedAsRequired %} required{% endif %}
                {%- if component.isAutofocused %} autofocus{% endif %}
        >
    {% endblock %}
{% endembed %}

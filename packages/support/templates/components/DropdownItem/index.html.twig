{% props
    tag = 'button',
    type = 'button',
    href = null,
    target = null,
    formId = null,
    disabled = false,

    color = 'gray',

    icon = null,
    iconAlias = null,
    iconSize = null,

    content = markup(block('content') ?? null)
%}

{% set colorAttrs = colorAttributes('Sylament\\Support\\Colors\\Components\\DropdownComponent\\ItemComponent', color) %}
{% set iconHtml = icon ? generateIconHtml(icon, iconAlias, size: iconSize) : null %}

<{{ tag }}
    {{ attributes.without('style').defaults({
        class: classes('sy sy-dropdown-item', {
            'sy-disabled': disabled,
        }, colorAttrs.class),
        style: styles(colorAttrs.style, attributes.all.style ?? null) ?: false,
        'aria-disabled': disabled ? 'true' : null,
        disabled: disabled and tag == 'button',
        form: formId ?: false,
        href: tag == 'a' and href ? href : false,
        target: tag == 'a' and target == '_blank' ? '_blank' : false,
        type: tag == 'button' ? type : false,
    }) }}
>
    {{- iconHtml -}}
    <span class="sy-dropdown-item-label">{{- content -}}</span>
</{{ tag }}>

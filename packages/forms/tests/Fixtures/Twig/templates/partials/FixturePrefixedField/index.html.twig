<twig:SylamentForms:FieldWrapper :field="component">
    <twig:block name="labelPrefix">{% if component.shouldRenderPrefix %}<span class="fixture-prefix">P</span>{% endif %}</twig:block>
    <twig:block name="labelSuffix">{% if component.shouldRenderSuffix %}<span class="fixture-suffix">S</span>{% endif %}</twig:block>
</twig:SylamentForms:FieldWrapper>

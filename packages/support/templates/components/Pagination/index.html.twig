{% props
    paginator,

    pageOptions = [],
    currentPerPage = null,
    currentPageOptionProperty = 'tableRecordsPerPage',

    extremeLinks = false
%}

{% set gap = constant('Sylament\\Support\\Pagination\\Paginator::GAP') %}
{% set page = paginator.getPage %}
{% set lastPage = paginator.getLastPage %}
{% set firstRecordNumber = paginator.getFirstRecordNumber %}
{% set totalRecordCount = paginator.getTotalRecordCount %}

<nav
    {{ attributes.defaults({
        class: classes('sy', 'sy-pagination'),
        'aria-label': 'Pagination',
    }) }}
>
    {% if firstRecordNumber is not null %}
        <span class="sy-pagination-overview">
            {% if totalRecordCount is not null %}
                Showing {{ firstRecordNumber }} to {{ paginator.getLastRecordNumber }} of {{ totalRecordCount }} results
            {% else %}
                Showing {{ firstRecordNumber }} to {{ paginator.getLastRecordNumber }} results
            {% endif %}
        </span>
    {% else %}
        <span class="sy-pagination-overview">
            {% if totalRecordCount is not null %}
                Showing 0 results of {{ totalRecordCount }}
            {% else %}
                Showing 0 results
            {% endif %}
        </span>
    {% endif %}

    {% if pageOptions|length > 1 %}
        <label class="sy-pagination-per-page">
            <span class="sy-pagination-per-page-label">Per page</span>
            <select class="sy-pagination-per-page-select" data-model="{{ currentPageOptionProperty }}">
                {% for option in pageOptions %}
                    <option value="{{ option }}" {{ attrs({selected: option == currentPerPage}) }}>
                        {{ option == 'all' ? 'All' : option }}
                    </option>
                {% endfor %}
            </select>
        </label>
    {% endif %}

    {% if paginator.hasPages %}
        <ol class="sy-pagination-items">
            {% if not paginator.onFirstPage %}
                {% if extremeLinks %}
                    <li>
                        <button type="button" class="sy-pagination-item" rel="first" aria-label="Go to the first page" {{ stimulus_action('live', 'action', parameters: {action: 'gotoTablePage', page: 1}) }}>
                            <twig:SylamentSupport:Icon icon="heroicons:chevron-double-left-20-solid" :alias="constant('Sylament\\Support\\Twig\\SupportIconAlias::PAGINATION_FIRST_BUTTON')" />
                        </button>
                    </li>
                {% endif %}
                <li>
                    <button type="button" class="sy-pagination-item" rel="prev" aria-label="Previous page" {{ stimulus_action('live', 'action', parameters: {action: 'gotoTablePage', page: page - 1}) }}>
                        <twig:SylamentSupport:Icon icon="heroicons:chevron-left-20-solid" :alias="constant('Sylament\\Support\\Twig\\SupportIconAlias::PAGINATION_PREVIOUS_BUTTON')" />
                    </button>
                </li>
            {% endif %}

            {% if totalRecordCount is not null %}
                {% for element in paginator.getPageWindow %}
                    {% if element is same as(gap) %}
                        <li><span class="sy-pagination-item sy-pagination-gap" aria-hidden="true">{{ gap }}</span></li>
                    {% else %}
                        <li>
                            <button
                                type="button"
                                {{ attrs({
                                    class: classes('sy-pagination-item', {'sy-pagination-item-active': element == page}),
                                    'aria-current': element == page ? 'page' : null,
                                    'aria-label': 'Go to page ' ~ element,
                                    disabled: element == page,
                                }) }}
                                {{ stimulus_action('live', 'action', parameters: {action: 'gotoTablePage', page: element}) }}
                            >
                                {{ element }}
                            </button>
                        </li>
                    {% endif %}
                {% endfor %}
            {% endif %}

            {% if paginator.hasMorePages %}
                <li>
                    <button type="button" class="sy-pagination-item" rel="next" aria-label="Next page" {{ stimulus_action('live', 'action', parameters: {action: 'gotoTablePage', page: page + 1}) }}>
                        <twig:SylamentSupport:Icon icon="heroicons:chevron-right-20-solid" :alias="constant('Sylament\\Support\\Twig\\SupportIconAlias::PAGINATION_NEXT_BUTTON')" />
                    </button>
                </li>
                {% if extremeLinks and lastPage is not null %}
                    <li>
                        <button type="button" class="sy-pagination-item" rel="last" aria-label="Go to the last page" {{ stimulus_action('live', 'action', parameters: {action: 'gotoTablePage', page: lastPage}) }}>
                            <twig:SylamentSupport:Icon icon="heroicons:chevron-double-right-20-solid" :alias="constant('Sylament\\Support\\Twig\\SupportIconAlias::PAGINATION_LAST_BUTTON')" />
                        </button>
                    </li>
                {% endif %}
            {% endif %}
        </ol>
    {% endif %}
</nav>

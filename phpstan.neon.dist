includes:
	- phpstan-baseline.neon

parameters:
    level: max

    reportUnmatchedIgnoredErrors: false

    paths:
        - packages/actions/src
        - packages/forms/src
        - packages/infolists/src
        - packages/notifications/src
        - packages/panels/src
        - packages/schemas/src
        - packages/support/src
        - packages/tables/src
        - packages/widgets/src

    ignoreErrors:
        -
            identifiers:
                - trait.unused
                - new.static

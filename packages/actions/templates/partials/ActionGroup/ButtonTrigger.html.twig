{% set extraAttributes = group.getExtraAttributeBag.toScalarAttributes %}
{% set triggerClasses = classes({'sy-outlined': group.isOutlined}, extraAttributes.class ?? null) %}

<twig:SylamentSupport:Button
    :icon="group.getIcon"
    :color="group.getColor ?? 'gray'"
    :size="group.getSize ?? 'md'"
    {{ ...extraAttributes }}
    {{ ...(triggerClasses ? {class: triggerClasses} : {}) }}
>
    {{- group.getLabel -}}
</twig:SylamentSupport:Button>

{% props
    breadcrumbs = [],
    heading = null,
    subheading = null,

    actions = markup(block('actions') ?? null)
%}

{% set hasBreadcrumbs = breadcrumbs is not empty %}
{% set hasHeading = heading is filled %}
{% set hasSubheading = subheading is filled %}
{% set hasHeadings = hasHeading or hasSubheading %}
{% set hasActions = actions is filled %}

<header {{ attrs({class: ['sy sy-pa-header', {'sy-pa-header-has-breadcrumbs': hasBreadcrumbs}]}, attributes.all) }}>
    {% if hasBreadcrumbs or hasHeadings %}
        <div class="sy-pa-header-headings">
            {% if hasBreadcrumbs %}
                <twig:SylamentSupport:Breadcrumbs :breadcrumbs="breadcrumbs" />
            {% endif %}

            {% if hasHeading %}
                <h1 class="sy-pa-header-heading">{{ heading }}</h1>
            {% endif %}

            {% if hasSubheading %}
                <p class="sy-pa-header-subheading">{{ subheading }}</p>
            {% endif %}
        </div>
    {% endif %}

    {% if hasActions %}
        <div class="sy-pa-header-actions">
            {{ actions }}
        </div>
    {% endif %}
</header>
